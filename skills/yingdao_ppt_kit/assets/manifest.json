{
  "$comment": "影刀 PPT 图库索引。选图流程：先按 slide role 定 tier，再在该 tier 内按 mood/industry 选具体图。safe_text_zone 告诉你标题该放哪一侧；built_in_clear_zone=true 表示图自带压字留白区，不要再叠重蒙版。",
  "version": 1,
  "tiers": {
    "atmosphere": {
      "dir": "assets/atmosphere",
      "purpose": "半出血章节页的左侧底纹、低密度声明页；本身太淡，不单独做章节页主视觉",
      "industry_bound": false,
      "max_reuse_per_deck": 3,
      "default_scrim": "scrim-wash",
      "note": "人工筛选的 16:9 生成图；灰度高、禁止叠重蒙版。目录中未登记到 images 的文件不得使用"
    },
    "hero": {
      "dir": "assets/hero",
      "purpose": "封面主视觉；也可做 divider-halfbleed 的出血主图",
      "industry_bound": true,
      "max_reuse_per_deck": 2,
      "default_scrim": "scrim-left"
    },
    "concept": {
      "dir": "assets/concept",
      "purpose": "案例页配图、流程页示意；也可做 divider-halfbleed 的出血主图",
